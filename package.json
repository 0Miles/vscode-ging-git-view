{
  "name": "ging-git-view-monorepo",
  "version": "0.9.0",
  "private": true,
  "license": "MIT",
  "scripts": {
    "typecheck": "pnpm -r --no-sort typecheck && tsc -p . --noEmit",
    "compile": "pnpm --filter ging-git-view run compile",
    "package": "pnpm --filter ging-git-view run package",
    "test": "vitest run --project backend && vitest run --project webview",
    "test:ext": "pnpm --filter ging-git-view run test:ext",
    "compile:desktop": "pnpm --filter @ging/desktop run compile",
    "test:e2e:desktop": "pnpm --filter @ging/desktop run test:e2e",
    "watch:esbuild": "pnpm --filter ging-git-view run watch:esbuild",
    "watch:tsc": "pnpm --filter ging-git-view run watch:tsc",
    "format": "oxfmt --check",
    "format:fix": "oxfmt .",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "l10n:check": "node ./scripts/check-l10n.js",
    "adr:check": "node ./scripts/check-adr.js"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/node": "catalog:",
    "esbuild": "catalog:",
    "eslint-plugin-import": "^2.32.0",
    "jsdom": "^29.0.2",
    "oxfmt": "^0.44.0",
    "oxlint": "^1.59.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.4"
  },
  "packageManager": "pnpm@10.33.0",
  "pnpm": {
    "peerDependencyRules": {
      "ignoreMissing": [
        "eslint"
      ]
    }
  }
}
