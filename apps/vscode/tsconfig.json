{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "types": ["node"],
    // The extension is not importable under its own name (its manifest is the
    // published one), so its modules reach each other through this alias.
    // esbuild and tests/tsconfig.json read these paths; vitest.config.ts
    // repeats the alias.
    "paths": {
      "@ging/vscode/*": ["./src/*"]
    }
  },
  "include": ["src"]
}
