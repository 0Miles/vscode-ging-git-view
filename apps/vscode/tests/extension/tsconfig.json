{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "module": "commonjs",
    "moduleResolution": "node",
    "rootDir": "../../../..",
    "outDir": "../out/extension",
    // `node` resolution does not read package `exports`, and the emitted
    // CommonJS cannot load the packages' .ts sources anyway, so the workspace
    // packages are compiled alongside the tests and tsc-alias rewrites these
    // to relative paths. Most specific pattern first.
    "paths": {
      "@ging/core/tests/helpers": ["../../../../packages/core/tests/helpers"],
      "@ging/core/*": ["../../../../packages/core/src/*"],
      "@ging/shared/*": ["../../../../packages/shared/src/*"],
      "@ging/webview/*": ["../../../../packages/webview/src/*"],
      "@ging/vscode/*": ["../../../../apps/vscode/src/*"]
    }
  },
  "include": ["./**/*.ts"]
}
