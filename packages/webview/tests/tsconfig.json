{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    // The suites run under jsdom but reach node's fs and path: the stylesheet
    // locks in styles/ read main.css off disk.
    "types": ["node"]
  },
  // The DOM suites drive the webview, whose globals (`l10n`, `viewState`, the
  // GG types...) are ambient declarations nothing imports.
  "include": ["./**/*.ts", "../src/**/*.d.ts"]
}
