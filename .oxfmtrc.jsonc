{
  "printWidth": 100,
  "useTabs": false,
  "tabWidth": 2,
  // CHANGELOG.md is generated by release-please and follows its formatting
  "ignorePatterns": [
    ".pnpm-store/**",
    ".idea/**",
    "**/out/**",
    "**/.vscode-test/**",
    "**/node_modules/**",
    "**/*.ctx.md",
    "CHANGELOG.md",
    // Written by a test as JSON.stringify writes it (apps/desktop/tests/settings/schema.test.ts)
    "apps/desktop/src/settings/schema.generated.json"
  ],
  "trailingComma": "none"
}
