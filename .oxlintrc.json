{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "extends": [
    "oxlint/baseline.config.json",
    "oxlint/pedantic.config.json",
    "oxlint/restriction.config.json",
    "oxlint/style.config.json"
  ],
  "jsPlugins": [{ "name": "import-js", "specifier": "eslint-plugin-import" }],
  "ignorePatterns": [
    ".pnpm-store/**",
    ".idea/**",
    "**/out/**",
    "**/node_modules/**",
    "*.config.js"
  ],
  "env": {
    "node": true
  },
  "plugins": ["typescript", "node", "oxc", "import", "unicorn"],
  "categories": {
    "correctness": "error", // Code that is definitely wrong or useless
    "perf": "error", // Rules that aim to improve runtime performance
    "suspicious": "error", // Code that is likely to be wrong or useless,
    "nursery": "error", // Rules that ban specific patterns or features,
    "pedantic": "off", // Extra strict rules that may have false positives
    "restriction": "off", // Rules under development that may change
    "style": "off" // Idiomatic and consistent style rules
  },
  "rules": {
    "import-js/order": [
      "error",
      {
        "groups": ["builtin", "external", "internal", ["parent", "sibling", "index"]],
        "pathGroups": [
          {
            "pattern": "@ging/*/tests/**",
            "group": "internal",
            "position": "after"
          },
          {
            "pattern": "@ging/**",
            "group": "internal",
            "position": "before"
          }
        ],
        "pathGroupsExcludedImportTypes": ["builtin"],
        "newlines-between": "always",
        "alphabetize": {
          "order": "asc",
          "caseInsensitive": true
        }
      }
    ],
    "eslint/no-unused-vars": [
      "error",
      {
        "argsIgnorePattern": "^_",
        "varsIgnorePattern": "^_",
        "fix": {
          "imports": "safe-fix",
          "variables": "suggestion"
        }
      }
    ],
    "unicorn/require-post-message-target-origin": "allow" // false-positive
  },
  "overrides": [
    {
      "files": ["apps/vscode/.vscode-test.mjs"],
      "rules": {
        "import/named": "off"
      }
    },
    {
      "files": ["packages/webview/**/*.ts"],
      "env": {
        "node": false,
        "browser": true
      }
    },
    {
      // The desktop preload runs in the page with Electron's renderer API; the
      // E2E hands functions to `page.evaluate`, which run in the page too.
      "files": ["apps/desktop/src/preload.ts", "apps/desktop/e2e/**/*.ts"],
      "env": {
        "browser": true
      }
    },
    {
      // Runs in both the webview and the extension host, so neither set of globals
      "files": ["packages/shared/**/*.ts"],
      "env": {
        "node": false,
        "browser": false
      }
    },
    {
      // The packages are host-neutral; only apps/vscode lists @types/vscode. That
      // alone fails the typecheck on a clean checkout, but not where a parent
      // directory has its own node_modules with the types in it (a worktree
      // inside a checkout), so the boundary is held here as well.
      "files": ["packages/**"],
      "rules": {
        "eslint/no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "vscode",
                "message": "packages/* must not depend on the VS Code API; take what you need as a parameter and let apps/vscode pass it."
              }
            ]
          }
        ]
      }
    },
    {
      // The apps leave git operations to core's command services; the reasons
      // and the whitelist are in ADR-0027's consequences. apps/desktop is held
      // to it from its first line (#386).
      "files": ["apps/vscode/src/**", "apps/desktop/src/**"],
      "rules": {
        "eslint/no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "@ging/core/backend/actions/**",
                  "@ging/core/backend/queries/**",
                  "!@ging/core/backend/queries/commitFileContent"
                ],
                "allowTypeImports": true,
                "message": "An app must not run core's git operations itself; put the flow in a core command service and register it here. Type imports are fine."
              }
            ]
          }
        ]
      }
    }
  ]
}
